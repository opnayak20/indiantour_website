# ==============================================================================
# Adventure Nature Club - Backend Environment Configuration
# ==============================================================================

# Application Environment ('local', 'staging', 'production')
APP_ENV=local

# Secret key used for signing session tokens (HMAC-SHA256).
# Must be configured.
APP_SECRET=replace_with_a_secure_random_32_character_secret_string

# CORS Allowed Origins (Comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database Configuration (Hostinger MySQL or local MySQL)
# Leave commented out to use the local SQLite fallback in backend/data/database.sqlite
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_NAME=u892283443_advnature_club
# DB_USER=u892283443_advnature_club
# DB_PASS=your_mysql_database_password

# SMTP Mail Configuration (Gmail App Password or custom SMTP server)
SMTP_HOST=ssl://smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM_NAME="Adventure Nature Club"
