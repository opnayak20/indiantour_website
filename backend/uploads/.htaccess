# Disable script execution in uploads directory
<FilesMatch "\.(php|php5|php7|php8|phtml|phar|pl|py|cgi|asp|js|sh)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|php5|php7|php8|phtml|phar|pl|py|cgi|asp|js|sh)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php5 .php7 .php8 .phar
RemoveType .php .phtml .php5 .php7 .php8 .phar
